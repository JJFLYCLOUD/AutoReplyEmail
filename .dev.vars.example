# Copy to .dev.vars for local development.

# Used to encrypt mailbox SMTP / IMAP / API credentials.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_KEY=replace-with-32-byte-base64-key

# Admin account used by the login page.
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-to-a-long-random-password

# Used to sign session cookies. Changing it logs everyone out.
AUTH_SESSION_SECRET=replace-with-32-byte-base64-session-secret
AUTH_SESSION_HOURS=12

ENVIRONMENT=development
