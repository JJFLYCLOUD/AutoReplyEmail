{
  "name": "auto-reply-email",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Workers based multi-mailbox auto-reply service",
  "scripts": {
    "dev": "concurrently -k -n worker,web -c cyan,magenta \"wrangler dev --port 8787\" \"vite\"",
    "dev:worker": "wrangler dev --port 8787",
    "dev:web": "vite",
    "build:client": "vite build",
    "build": "npm run build:client && wrangler deploy --dry-run --outdir dist/worker",
    "deploy": "npm run build:client && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fake:imap": "node scripts/fake-imap.mjs 20993",
    "fake:pop3": "node scripts/fake-pop3.mjs 21025",
    "fake:smtp": "node scripts/fake-smtp.mjs 2525",
    "db:migrate:local": "wrangler d1 migrations apply auto-reply-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply auto-reply-db --remote"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "jose": "^6.2.14",
    "mimetext": "^3.0.28",
    "postal-mime": "^4.2.0",
    "worker-mailer": "^1.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
